{
  "name": "ecomcn",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source e-commerce blocks for shadcn/ui.",
  "license": "MIT",
  "homepage": "https://ecomcn.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/its-Inbarajan/ecomcn"
  },
  "scripts": {
    "sync": "node scripts/sync-registry.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/sync-registry.mjs && shadcn build && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node scripts/sync-registry.mjs && tsc --noEmit",
    "registry:validate": "shadcn registry validate",
    "registry:build": "shadcn build",
    "registry:check": "shadcn build && node scripts/check-registry.mjs",
    "registry:check:live": "node scripts/check-registry.mjs --remote",
    "test:install": "node scripts/verify-install.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.37.0",
    "motion": "^13.4.4",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
